---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const l = (path: string) => `${base}/${lang}${path}`;
const github = 'https://github.com/NeoDOS-Project/NeoDOS';
---

<BaseLayout lang={lang} title={t.resources.meta.title} description={t.resources.meta.description}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{t.resources.hero.eyebrow}</span>
      <h1>{t.resources.hero.titleA}<br />{t.resources.hero.titleB}</h1>
      <p class="lead">{t.resources.hero.lead}</p>
      <div class="hero__meta">
        {
          t.resources.hero.badges.map((badge, index) => (
            <span class:list={['badge', index === 0 && 'badge--green', index === 1 && 'badge--cyan']}>
              {badge}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.resources.repos.eyebrow}</span>
        <h2>{t.resources.repos.title}</h2>
        <p>{t.resources.repos.lead}</p>
      </div>

      <div class="repo-grid">
        {
          t.resources.repoList.map((repo) => (
            <a class="repo" href={repo.url} target="_blank" rel="noopener noreferrer">
              <div class="repo__top">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
                </svg>
                <span class="repo__name">{repo.name}</span>
              </div>
              <p>{repo.description}</p>
              <span class="repo__tag">{repo.tag} ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.resources.docs.eyebrow}</span>
        <h2>{t.resources.docs.title}</h2>
        <p>{t.resources.docs.lead}</p>
      </div>

      <div class="doc-list">
        {
          t.resources.docs.links.map((link) => (
            <a class="doc-link" href={link.href} target="_blank" rel="noopener noreferrer">
              <span>{link.label}</span>
              <Icon name="external" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.resources.contribute.eyebrow}</span>
        <h2>{t.resources.contribute.title}</h2>
        <p>{t.resources.contribute.lead}</p>
      </div>

      <div class="card-grid">
        {
          t.resources.contribute.cards.map((card) => (
            <article class="card">
              <span class="card__icon"><Icon name={card.icon as any} /></span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="section-actions">
                <a class="btn btn--ghost btn--sm" href={card.href} target="_blank" rel="noopener noreferrer">
                  {card.action}
                  <Icon name="external" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <div class="cta">
        <span class="eyebrow">{t.resources.cta.eyebrow}</span>
        <h2>{t.resources.cta.title}</h2>
        <p>{t.resources.cta.body}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={l('/getting-started/')}>
            {t.resources.cta.primary}
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href={github} target="_blank" rel="noopener noreferrer">
            {t.resources.cta.secondary}
            <Icon name="external" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
