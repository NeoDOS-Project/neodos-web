---
import BrandMark from './BrandMark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getRelativePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  localized?: boolean;
}

const { lang, localized = true } = Astro.props;
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '/', label: t.nav.home },
  { href: '/architecture/', label: t.nav.architecture },
  { href: '/getting-started/', label: t.nav.gettingStarted },
  { href: '/roadmap/', label: t.nav.roadmap },
  { href: '/resources/', label: t.nav.resources },
];

const relative = getRelativePath(Astro.url.pathname, lang).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? relative === '/' : relative === href.replace(/\/$/, ''));

const github = 'https://github.com/NeoDOS-Project/NeoDOS';
---

<header class="site-header" data-open="false">
  <div class="container site-header__inner">
    <a class="brand" href={`${base}/${lang}/`} aria-label="NeoDOS — home">
      <BrandMark />
      <span>
        Neo<em>DOS</em>
        <span class="brand__sub">Rust · x86-64</span>
      </span>
    </a>

    <nav class="nav" id="main-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
      {
        links.map((link) => (
          <a
            href={`${base}/${lang}${link.href}`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <span class="version-pill">v0.51.5</span>
      <a class="btn btn--ghost btn--sm" href={github} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
        <span>GitHub</span>
      </a>
      {localized && <LanguageSwitcher lang={lang} />}
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label={t.common.openMenu}
      >
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>
